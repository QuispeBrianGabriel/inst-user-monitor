# syntax=docker/dockerfile:1
# Versiones fijadas: deben coincidir con rust-toolchain.toml, dockerfile.dev y
# .github/workflows/pipeline.yml (paridad dev/prod).
ARG RUST_VERSION=1.100.0
ARG BINSTALL_VERSION=1.27.0
ARG TRUNK_VERSION=0.22.1

# ---------- Build ----------
FROM rust:${RUST_VERSION}-trixie AS builder
ARG BINSTALL_VERSION
ARG TRUNK_VERSION

RUN rustup target add wasm32-unknown-unknown \
    && curl -L --proto '=https' --tlsv1.2 -sSf \
        "https://raw.githubusercontent.com/cargo-bins/cargo-binstall/v${BINSTALL_VERSION}/install-from-binstall-release.sh" \
        | BINSTALL_VERSION="$BINSTALL_VERSION" bash \
    && cargo binstall -y --locked "trunk@${TRUNK_VERSION}"

WORKDIR /app
COPY . .
# El artefacto no lleva configuración: la URL de la API se inyecta al arrancar.
RUN trunk build --release

# ---------- Runtime ----------
FROM nginx:1.27-alpine

# Configuración de runtime (12-factor, III y VII). Valores por defecto:
#   PORT    → puerto en el que escucha nginx (Railway/Heroku lo inyectan)
#   API_URL → URL pública de la API, expuesta al navegador en /config.js
ENV PORT=80 \
    API_URL=http://localhost:8080

# La imagen oficial procesa /etc/nginx/templates/*.template con envsubst al
# arrancar y deja el resultado en /etc/nginx/conf.d/. Solo se sustituyen las
# variables definidas en el entorno, así que $uri y compañía no se tocan.
COPY <<'NGINX' /etc/nginx/templates/default.conf.template
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Fallback SPA: las rutas del router de Leptos sirven index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Generado al arrancar: nunca se cachea, para que un cambio de config
    # se aplique con solo reiniciar el contenedor
    location = /config.js {
        add_header Cache-Control "no-store";
    }

    location ~* \.(wasm|js|css|png|jpg|svg|ico|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    gzip on;
    gzip_types text/css application/javascript application/wasm image/svg+xml;
}
NGINX

# Genera /config.js desde el entorno antes de arrancar nginx
COPY --chmod=755 <<'SH' /docker-entrypoint.d/40-app-config.sh
#!/bin/sh
set -eu
# Escapa \ y " para producir un literal de JS válido
api_url=$(printf '%s' "$API_URL" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
printf 'window.__APP_CONFIG__ = {\n  apiUrl: "%s",\n};\n' "$api_url" \
    > /usr/share/nginx/html/config.js
echo "$0: config.js generado (API_URL=$API_URL)"
SH

COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
