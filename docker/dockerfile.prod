# syntax=docker/dockerfile:1
# ---------- Build ----------
FROM rust:1-trixie AS builder

RUN rustup toolchain install stable --profile minimal --target wasm32-unknown-unknown \
    && rustup default stable \
    && curl -L --proto '=https' --tlsv1.2 -sSf \
        https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash \
    && cargo binstall -y --locked trunk

WORKDIR /app
COPY . .
# URL pública de la API, incrustada en el wasm al compilar (Railway la pasa como build arg)
ARG API_URL=http://localhost:8080
RUN API_URL="$API_URL" trunk build --release

# ---------- Runtime ----------
FROM nginx:1.27-alpine

COPY <<'NGINX' /etc/nginx/conf.d/default.conf
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Fallback SPA: las rutas del router de Leptos sirven index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(wasm|js|css|png|jpg|svg|ico|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    gzip on;
    gzip_types text/css application/javascript application/wasm image/svg+xml;
}
NGINX

COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
