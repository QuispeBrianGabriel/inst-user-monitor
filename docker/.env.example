# Copiar a docker/.env y ajustar. Todas tienen valores por defecto en compose.yml.

# UID/GID del usuario del host (ver `id -u` / `id -g`) para evitar problemas de permisos
USER_UID=1000
USER_GID=1000

# Puerto del host para `trunk serve` (desarrollo)
DEV_PORT=3000

# Puerto del host para nginx (producción). No usar 8080: es el de la API local.
PROD_PORT=8081

# URL pública de la API que usa el front de producción. Se lee al ARRANCAR el
# contenedor (no al compilar), así que basta con reiniciarlo para cambiarla.
API_URL=http://localhost:8080
